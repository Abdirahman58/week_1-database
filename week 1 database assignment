-- Display all customers
SELECT * FROM customers;

-- Display all menu items
SELECT * FROM menu_items;

-- Display all orders
SELECT * FROM orders;

-- Display customers and their orders
SELECT
customers.first_name,
customers.last_name,
orders.order_id,
orders.order_date
FROM customers
JOIN orders
ON customers.customer_id = orders.customer_id;

-- Display order details
SELECT
order_items.order_id,
menu_items.item_name,
menu_items.price,
order_items.quantity
FROM order_items
JOIN menu_items
ON order_items.item_id = menu_items.item_id;

-- Find menu items costing more than 500
SELECT *
FROM menu_items
WHERE price > 500;

-- Update a menu item price
UPDATE menu_items
SET price = 700.00
WHERE item_id = 1;

-- Delete an order item
DELETE FROM order_items
WHERE order_item_id = 5;
